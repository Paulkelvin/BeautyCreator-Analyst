# Copy to .env.local — see docs/SETUP.md for full instructions.
# Do NOT commit .env.local. Omit optional keys entirely (empty strings break builds on Vercel).

# App (set to your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog — omit both if unused
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Supabase — required for persisted data (create project first)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App owner (Supabase Auth user UUID) — required to save analyses on Vercel
# APP_OWNER_USER_ID=

# YouTube Data API v3 — required for YouTube competition intelligence
# YOUTUBE_API_KEY=

# OpenAI — recommended; app falls back to heuristics without it
# OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini

# Upstash Redis — omit both if unused
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Inngest — required for background ingest jobs
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Optional extraction CLIs (not available on default Vercel serverless)
YOUTUBE_COMMENT_DOWNLOADER_COMMAND=youtube-comment-downloader
TIKTOK_EXTRACTOR_COMMAND=tiktok-scraper
